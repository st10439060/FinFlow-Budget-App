<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_secondary">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/green_primary"
        android:elevation="4dp"
        app:title="Manage Categories"
        app:titleTextColor="@color/white"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Add New Category Card (fixed at top, never scrolls away) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_add_category"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add New Category"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="16dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Category Name"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_category_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Emoji (e.g. 🛒)"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_category_emoji"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLength="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Description (Optional)"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="16dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_category_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:lines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Color picker row -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Category Color"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/ll_color_picker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <View android:id="@+id/swatch_red"    android:layout_width="36dp" android:layout_height="36dp" android:layout_marginEnd="8dp" android:background="#F44336" />
                <View android:id="@+id/swatch_orange" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginEnd="8dp" android:background="#FF9800" />
                <View android:id="@+id/swatch_yellow" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginEnd="8dp" android:background="#FFC107" />
                <View android:id="@+id/swatch_green"  android:layout_width="36dp" android:layout_height="36dp" android:layout_marginEnd="8dp" android:background="#4CAF50" />
                <View android:id="@+id/swatch_teal"   android:layout_width="36dp" android:layout_height="36dp" android:layout_marginEnd="8dp" android:background="#009688" />
                <View android:id="@+id/swatch_blue"   android:layout_width="36dp" android:layout_height="36dp" android:layout_marginEnd="8dp" android:background="#2196F3" />
                <View android:id="@+id/swatch_brown"  android:layout_width="36dp" android:layout_height="36dp" android:layout_marginEnd="8dp" android:background="#795548" />

            </LinearLayout>

            <!-- Selected color preview -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selected: "
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_gravity="center_vertical" />

                <View
                    android:id="@+id/view_selected_color"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="#4CAF50"
                    android:layout_gravity="center_vertical" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add Category"
                android:backgroundTint="@color/green_primary" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Your Categories label -->
    <TextView
        android:id="@+id/tv_categories_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your Categories"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/card_add_category"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- RecyclerView fills remaining screen height and scrolls independently -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_categories"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="true"
        app:layout_constraintTop_toBottomOf="@id/tv_categories_label"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
